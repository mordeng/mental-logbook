// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication Models
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  therapist         Therapist?
  dailyCheckIns     DailyCheckIn[]

  @@index([email])
}

model Therapist {
  id            String   @id @default(cuid())
  passcodeHash  String
  patientId     String   @unique
  patient       User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accessLogs    TherapistAccessLog[]
}

model TherapistAccessLog {
  id          String    @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  accessedAt  DateTime  @default(now())
  ipAddress   String?

  @@index([therapistId, accessedAt])
}

// ============================================
// Daily Check-In
// ============================================

model DailyCheckIn {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime 
  moodRating  Int      // 1-10
  feelingText String   
  needText    String   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  emotionalNeeds EmotionalNeed[]

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
}

model EmotionalNeed {
  id          String       @id @default(cuid())
  checkInId   String
  checkIn     DailyCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  needType    String       // emotional_closeness, intellectual_stimulation, etc.
  customNeed  String?      // For "Other"

  @@index([checkInId])
}
