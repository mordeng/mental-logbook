// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication Models
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  therapist         Therapist?
  dailyCheckIns     DailyCheckIn[]
  ffnLogs           FFNLog[]
  weeklyTrackers    WeeklyTracker[]
  boundaryCheckIns  BoundaryCheckIn[]
  meaningGoals      MeaningGoal[]
  joyActivities     JoyActivity[]
  safeContacts      SafeContact[]
  crisisActions     CrisisAction[]
  crisisLogs        CrisisLog[]

  @@index([email])
}

model Therapist {
  id            String   @id @default(cuid())
  passcodeHash  String
  patientId     String   @unique
  patient       User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accessLogs    TherapistAccessLog[]
}

model TherapistAccessLog {
  id          String    @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  accessedAt  DateTime  @default(now())
  ipAddress   String?

  @@index([therapistId, accessedAt])
}

// ============================================
// Daily Check-In
// ============================================

model DailyCheckIn {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime 
  moodRating  Int      // 1-10
  feelingText String   
  needText    String   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  emotionalNeeds EmotionalNeed[]

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
}

model EmotionalNeed {
  id          String       @id @default(cuid())
  checkInId   String
  checkIn     DailyCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  needType    String       // emotional_closeness, intellectual_stimulation, etc.
  customNeed  String?      // For "Other"

  @@index([checkInId])
}

// ============================================
// FFN Communication Log
// ============================================

model FFNLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @default(now())
  contactName   String
  fact          String   
  feeling       String   
  need          String   
  response      String?  
  afterFeeling  String?  
  afterMood     Int?     // 1-10
  successRating String?  // successful, difficult, neutral
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, date(sort: Desc)])
  @@index([userId, contactName])
}

// ============================================
// Weekly Connection Tracker
// ============================================

model WeeklyTracker {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate DateTime  // Monday of the week
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  actions ConnectionAction[]

  @@unique([userId, weekStartDate])
  @@index([userId, weekStartDate(sort: Desc)])
}

model ConnectionAction {
  id            String        @id @default(cuid())
  trackerId     String
  tracker       WeeklyTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  actionType    String        // safe_contact, new_context, vulnerability_step
  description   String        
  beforeMood    Int?          // 1-10
  afterMood     Int?          // 1-10
  wouldRepeat   String?       // yes, no, maybe
  notes         String?       
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([trackerId])
}

// ============================================
// Boundary Check-In
// ============================================

model BoundaryCheckIn {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @default(now())
  situation      String   
  wantIt         Boolean
  feelsMutual    Boolean
  nourishOrDrain String  // nourish, drain, unsure
  decision       String  // yes, no, postpone
  reflection     String?  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, date(sort: Desc)])
}

// ============================================
// Meaning & Belonging
// ============================================

model MeaningGoal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       DateTime  // First day of month
  goalType    String   // join_group, volunteer, share_creativity, other
  description String   
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reflections MeaningReflection[]

  @@unique([userId, month])
  @@index([userId, month(sort: Desc)])
}

model MeaningReflection {
  id        String      @id @default(cuid())
  goalId    String
  goal      MeaningGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date      DateTime    @default(now())
  prompt    String      
  content   String      
  createdAt DateTime    @default(now())

  @@index([goalId, date(sort: Desc)])
}

// ============================================
// Joy Activity
// ============================================

model JoyActivity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate   DateTime  // Monday of the week
  plannedActivity String   
  completed       Boolean  @default(false)
  rating          Int?     // 1-10
  notes           String?  
  photoUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, weekStartDate])
  @@index([userId, weekStartDate(sort: Desc)])
}

// ============================================
// Safety Net
// ============================================

model SafeContact {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  relationship String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, order])
}

model CrisisAction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String   
  enabled     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, order])
}

model CrisisLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestamp    DateTime @default(now())
  actionsTaken String   
  notes        String?  

  @@index([userId, timestamp(sort: Desc)])
}
